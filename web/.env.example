# Browser-safe values. A publishable Supabase key is expected in a web bundle;
# never use a service-role or secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public Edge Function URL. The browser sends its Supabase bearer token; it
# never stores a workspace ID or a connection capability.
VITE_EARNLINE_SYNC_ENDPOINT=https://your-project.supabase.co/functions/v1/earnline-sync
VITE_EARNLINE_PAIR_ENDPOINT=https://your-project.supabase.co/functions/v1/earnline-pair-device
