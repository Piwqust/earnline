# Public URL only. Enter the per-device connection code once in Settings; never
# put it in a VITE_* variable because Vite embeds those values in browser JS.
VITE_EARNLINE_SYNC_ENDPOINT=https://your-project.supabase.co/functions/v1/earnline-sync

# Local development escape hatch only. Production builds ignore direct mode;
# enter development URL/key/workspace manually in Settings so they are never
# available to Vite's compile-time environment replacement.
