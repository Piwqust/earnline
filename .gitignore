.DS_Store

# Xcode local state
xcuserdata/
*.xcuserstate
*.moved-aside
DerivedData/
.derived-data/
*.hmap

# Build outputs
build/
.build/

# Local/private screenshots
docs/screenshots/*.png
docs/screenshots/*.jpg
docs/screenshots/*.jpeg

# SwiftPM working checkouts
.swiftpm/

# Local editor and tool state
.vscode/
.idea/
.xcodebuildmcp/
.playwright-mcp/
.cursor/
.codegraph/
.ios-simulator-output/

# Secrets and local environment
.env
.env.*
!.env.example
ios-app/Config/Local.private.xcconfig

# Private operational backups (may contain real ledger and workspace data)
.local-backups/

# Supabase CLI link and connection cache
supabase/.temp/

# Stray plist a mis-redirected `xcodebuild -destination ... > -` leaves behind.
-

# Graphify navigation output (generated, regenerable)
graphify-out/
